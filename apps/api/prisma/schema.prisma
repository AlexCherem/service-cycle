generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Company {
  id        String   @id @default(uuid()) @db.Uuid
  name      String
  users     User[]
  clients   Client[]
  equipment Equipment[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("companies")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  companyId    String   @map("company_id") @db.Uuid
  email        String   @unique
  passwordHash String   @map("password_hash")
  company      Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([companyId], map: "users_company_id_idx")
  @@map("users")
}

model Client {
  id        String   @id @default(uuid()) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  phone     String?
  email     String?
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Restrict)
  equipment Equipment[]
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([companyId, phone], map: "clients_company_id_phone_key")
  @@map("clients")
}

model Equipment {
  id               String    @id @default(uuid()) @db.Uuid
  companyId        String    @map("company_id") @db.Uuid
  clientId         String    @map("client_id") @db.Uuid
  name             String
  installationDate DateTime? @map("installation_date") @db.Date
  lastServiceDate  DateTime? @map("last_service_date") @db.Date
  nextServiceDate  DateTime? @map("next_service_date") @db.Date
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Restrict)
  client           Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@unique([clientId, name], map: "equipment_client_id_name_key")
  @@index([companyId, clientId], map: "equipment_company_id_client_id_idx")
  @@map("equipment")
}
